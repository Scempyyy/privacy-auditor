# ==========================================
# Android Privacy Auditor - Environment Config
# ==========================================

# Backend Configuration
ANALYZER_HOST=127.0.0.1
ANALYZER_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Frontend Configuration
NEXT_PUBLIC_ANALYZER_URL=http://localhost:8000

# Storage & Processing Limits
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=/tmp/android-privacy-auditor/uploads
